.text-base {
    -unity-font-style: bold;
    -unity-text-outline-width: 0.5px;
    -unity-font-definition: resource("Fonts/TIMES");
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.text-error {
    color: rgb(255, 0, 0);
    -unity-text-outline-color: rgb(51, 0, 0);
}

.text-success {
    color: rgb(43, 255, 0);
    -unity-text-outline-color: rgb(9, 51, 0);
}

.text-info {
    color: rgb(0, 212, 255);
    -unity-text-outline-color: rgb(0, 42, 51);
}

.text-parameter {
    color: rgb(255, 150, 0);
    -unity-text-outline-color: rgb(51, 30, 0);
}


