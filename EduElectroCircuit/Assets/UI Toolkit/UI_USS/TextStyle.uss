.text-base {
    -unity-font-style: bold;
    -unity-font-definition: resource("Fonts/TIMES");
    -unity-text-outline-width: 0.5px;
    color: rgb(153, 153, 153);
    -unity-text-outline-color: rgb(0, 0, 0);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 9px;
}

.text-error {
    color: rgb(255, 0, 0);
    -unity-text-outline-color: rgb(51, 0, 0);
}

.text-success {
    color: rgb(43, 255, 0);
    -unity-text-outline-color: rgb(9, 51, 0);
}

.text-info {
    color: rgb(0, 212, 255);
    -unity-text-outline-color: rgb(0, 42, 51);
    -unity-text-align: upper-center;
}

.text-parameter {
    color: rgb(255, 150, 0);
    -unity-text-outline-color: rgb(51, 30, 0);
}

.text-button {
    -unity-font-style: bold;
    -unity-font-definition: resource("Fonts/TIMES");
    -unity-text-outline-width: 0.5px;
    color: rgb(229, 229, 229);
    -unity-text-outline-color: rgb(77, 77, 77);
    font-size: 9px;
}
