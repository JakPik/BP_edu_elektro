.menu-title {
    font-size: 90px;
    -unity-text-outline-width: 6px;
    -unity-font-style: bold;
    color: rgb(0, 220, 255);
    -unity-text-outline-color: rgb(0, 44, 51);
    -unity-font-definition: resource("Fonts/TIMES");
}

.panel-title {
    color: rgb(0, 218, 255);
    -unity-text-outline-color: rgb(0, 43, 51);
    -unity-text-outline-width: 0.5px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}



.property-display .label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 1px;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 6px;
    -unity-font-definition: resource("Fonts/TIMES");
}

.property-display .label-success {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 6px;
    -unity-font-definition: resource("Fonts/TIMES");
}

.property-display .label-error {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 6px;
    -unity-font-definition: resource("Fonts/TIMES");
}

.property-display .label-param {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 1px;
    margin-left: 1px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 6px;
    -unity-font-definition: resource("Fonts/TIMES");
}

.label {
    -unity-font-style: bold;
    color: rgb(0, 216, 255);
    -unity-text-outline-color: rgb(0, 43, 51);
    -unity-text-outline-width: 0.3px;
    font-size: 8px;
}

.label-success {
    color: rgb(19, 249, 0);
    -unity-text-outline-color: rgb(0, 51, 6);
    -unity-text-outline-width: 0.3px;
    -unity-font-style: bold;
    font-size: 8px;
}

.label-error {
    color: rgb(255, 0, 0);
    -unity-text-outline-color: rgb(51, 0, 0);
    -unity-text-outline-width: 0.3px;
    -unity-font-style: bold;
    font-size: 8px;
}

.label-param {
    -unity-font-style: bold;
    color: rgb(255, 170, 0);
    -unity-text-outline-color: rgb(51, 34, 0);
    -unity-text-outline-width: 0.3px;
    font-size: 8px;
}

.interactive-button {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 1px;
    padding-right: 5px;
    padding-bottom: 1px;
    padding-left: 5px;
    background-color: rgb(4, 192, 211);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(0, 167, 255);
    border-right-color: rgb(0, 98, 149);
    border-top-color: rgb(0, 167, 255);
    border-bottom-color: rgb(0, 98, 150);
    border-top-left-radius: 2px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 0;
    align-self: center;
    top: 10px;
}

.interactive-button.hover {
    font-size: 9px;
    padding-top: 1px;
    padding-right: 5px;
    padding-bottom: 1px;
    padding-left: 5px;
    white-space: pre;
    -unity-text-align: middle-center;
    align-self: center;
    background-color: rgb(132, 244, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(113, 206, 255);
    border-right-color: rgb(0, 149, 227);
    border-top-color: rgb(113, 206, 255);
    border-bottom-color: rgb(0, 149, 227);
    border-top-left-radius: 2px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 0;
    color: rgb(0, 115, 255);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0.3px;
    -unity-text-outline-color: rgb(0, 15, 136);
    transition-duration: 0.1s;
    margin-top: 0;
    top: 10px;
    scale: 1.1 1.1;
}

.interactive-button.active {
    font-size: 9px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 1px;
    padding-right: 5px;
    padding-bottom: 1px;
    padding-left: 5px;
    position: relative;
    white-space: pre;
    -unity-text-align: middle-center;
    align-self: center;
    background-color: rgb(202, 250, 255);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(213, 241, 255);
    border-right-color: rgb(75, 193, 255);
    border-top-color: rgb(213, 241, 255);
    border-bottom-color: rgb(75, 193, 255);
    border-top-left-radius: 2px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 0;
    color: rgb(51, 184, 253);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    -unity-text-outline-width: 0.3px;
    -unity-text-outline-color: rgb(0, 28, 255);
    transition-duration: 0.1s;
    top: 11px;
}

.button-off {
    border-top-color: rgb(255, 0, 0);
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(149, 5, 0);
    border-bottom-color: rgb(149, 5, 0);
    background-color: rgb(255, 132, 135);
}

.button-on {
    border-top-color: rgb(0, 255, 2);
    border-left-color: rgb(0, 255, 2);
    border-right-color: rgb(0, 149, 4);
    border-bottom-color: rgb(0, 149, 4);
    background-color: rgb(132, 255, 136);
}

.update_tag {
    font-size: 20px;
    -unity-text-align: upper-left;
    color: rgb(7, 93, 0);
    -unity-font-definition: resource("Fonts/TIMES");
    margin-left: 15px;
    rotate: -20deg;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 35px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(4, 255, 0);
    letter-spacing: 15px;
    word-spacing: 10px;
    transition-timing-function: ease-out-back;
    transition-duration: 1.2s;
    transition-delay: 0s;
}

.update_tag_hidden {
    opacity: 0;
    transition-timing-function: ease-out-bounce;
    transition-duration: 0.2s;
    scale: 0 0 0;
}

.star_hidden {
    width: 10px;
    height: 10px;
    opacity: 0;
    position: absolute;
}

.star_visible {
    opacity: 1;
    width: 70px;
    height: 70px;
    transition-timing-function: ease-out-back;
    transition-duration: 0.7s;
}

.UI_text_style {
    color: rgb(62, 193, 224);
    -unity-font-definition: resource("Fonts/TIMES");
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 20, 74);
    -unity-font-style: bold;
}
