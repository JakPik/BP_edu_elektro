.menu-button {
    font-size: 50px;
    background-color: rgb(14, 41, 101);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-left-color: rgb(43, 130, 154);
    border-right-color: rgb(43, 130, 154);
    border-top-color: rgb(43, 130, 154);
    border-bottom-color: rgb(43, 130, 154);
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out-back;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(20, 0, 134);
    width: 300px;
    -unity-font-definition: resource("Fonts/TIMES");
    -unity-font-style: bold;
}

.menu-button:enabled:hover {
    background-color: rgb(65, 102, 184);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    scale: 1.1 1.1;
    transition-timing-function: ease-out-back;
    transition-duration: 1s;
    -unity-font-style: bold;
    color: rgb(255, 196, 82);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
}


