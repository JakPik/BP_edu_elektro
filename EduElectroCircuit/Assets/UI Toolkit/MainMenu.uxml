                    <ui:VisualElement name="VisualElement" style="background-color: rgba(25, 45, 55, 0.5); padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: url(&quot;project://database/Assets/Textures/UI/Frame_silver.png?fileID=2800000&amp;guid=65eac62635775634bb01278b7f4f6e80&amp;type=3#Frame_silver&quot;); -unity-background-image-tint-color: rgb(255, 255, 255);">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: flex-start; margin-left: 110px; margin-top: 20px;">
