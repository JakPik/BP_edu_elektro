    <ui:VisualElement name="MainMenuContainer" picking-mode="Ignore" style="background-color: rgba(0, 0, 0, 0.4); position: absolute; flex-grow: 1; display: flex; width: 100%; height: 100%;">
        <ui:VisualElement name="MainMenuPanel" style="background-color: rgba(9, 0, 102, 0.8); align-items: center; flex-grow: 1; width: 550px; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px; justify-content: space-between;">
            <ui:Label text="Electrician Demo" class="menu-title" style="white-space: pre-wrap; -unity-text-align: upper-center;"/>
            <ui:VisualElement style="flex-grow: 1; align-items: flex-start; justify-content: center;">
                <ui:VisualElement style="flex-grow: 0; align-items: center; justify-content: center; width: 350px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
                    <ui:Button text="Play&#10;" name="Play_Button" class="menu-button" style="text-overflow: clip; white-space: pre-wrap; -unity-text-align: middle-center;"/>
                </ui:VisualElement>
                <ui:VisualElement name="" style="flex-grow: 0; justify-content: center; align-items: center; width: 350px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
                    <ui:Button text="Continue" name="" enabled="false" class="menu-button" style="text-overflow: clip; white-space: pre-wrap; -unity-text-align: middle-center; display: flex;"/>
                </ui:VisualElement>
                <ui:VisualElement name="" style="flex-grow: 0; align-items: center; justify-content: center; width: 350px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
                    <ui:Button text="Levels" name="Levels" class="menu-button" style="text-overflow: clip; white-space: pre-wrap; -unity-text-align: middle-center;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 0; align-items: center; justify-content: center; width: 350px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
                    <ui:Button text="Settings" name="" enabled="false" class="menu-button" style="text-overflow: clip; white-space: pre-wrap; -unity-text-align: middle-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="flex-grow: 0; align-items: center; justify-content: center; width: 350px;">
                <ui:Button text="Odejít" name="Quit_Button" class="menu-button" style="text-overflow: clip; white-space: pre-wrap; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="LevelSelectContainer" style="background-color: rgba(0, 0, 0, 0.2); position: absolute; flex-grow: 1; display: flex; background-image: none; width: 100%; height: 100%;">
