            <ui:Label text="Level Select" name="Label" style="color: rgb(255, 255, 255); font-size: 80%; white-space: normal; -unity-font-style: normal; -unity-font-definition: resource(&quot;Fonts/TIMES&quot;); -unity-text-align: middle-left; position: absolute; left: 393px; top: 0;"/>
