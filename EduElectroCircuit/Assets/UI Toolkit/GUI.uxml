<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UI_USS/TextStyle.uss?fileID=7433441132597879392&amp;guid=4bfa4f5599d4b304db9593cd4b56e35b&amp;type=3#TextStyle"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI_USS/ButtonStyle.uss?fileID=7433441132597879392&amp;guid=d1c1ee34e1d3eba44b370c73f29799e9&amp;type=3#ButtonStyle"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI_USS/PanelStyle.uss?fileID=7433441132597879392&amp;guid=9c491798e8ed20e41a3716e8ca8b1d30&amp;type=3#PanelStyle"/>
    <Style src="project://database/Assets/UI%20Toolkit/UI_USS/InfoLabelStyle.uss?fileID=7433441132597879392&amp;guid=1db002b2b8aecf849afc78b48086d734&amp;type=3#InfoLabelStyle"/>
    <ui:VisualElement name="PauseGUI" class="panel-hidden" style="position: absolute; width: 100%; height: 100%; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.7);">
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 50%; height: 80%; background-color: rgba(4, 0, 113, 0.7); align-items: center; justify-content: center; background-size: 100% 100%;">
            <ui:Label text="Pause" class="menu-title"/>
            <ui:VisualElement style="flex-grow: 1; align-content: auto; align-items: center; justify-content: space-evenly; margin-top: 20px; margin-bottom: 40px; width: 100%;">
                <ui:Button text="Resume" name="ResumeButton" class="menu-button" style="width: 300px; height: 100px;"/>
                <ui:Button text="Restart" name="RestartButton" class="menu-button" style="width: 300px; height: 100px;"/>
                <ui:Button text="Settings" name="SettingsButton" enabled="false" focusable="false" picking-mode="Ignore" class="menu-button" style="width: 300px; height: 100px;"/>
                <ui:Button text="Main Menu" name="MainMenuButton" class="menu-button" style="width: 300px; height: 100px;"/>
            </ui:VisualElement>
            <Bindings>
                <ui:DataBinding property="style.backgroundColor" data-source-path="borderPrimary" binding-mode="ToTarget"/>
            </Bindings>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PlayerGUI" picking-mode="Ignore" class="panel-visible" style="flex-grow: 1; align-items: center; justify-content: center; align-self: auto; position: absolute; flex-shrink: 1; align-content: auto; flex-direction: column; width: 100%; height: 100%;">
        <ui:VisualElement name="InteractionContainer" style="flex-grow: 0; left: 51%; right: auto; top: auto; bottom: auto; align-items: flex-start; justify-content: center; align-self: auto; align-content: auto; flex-basis: auto; flex-direction: column; aspect-ratio: auto; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-wrap: nowrap; flex-shrink: 1; position: absolute;">
            <ui:VisualElement name="InteractPanel" style="flex-grow: 1; flex-direction: row; background-color: rgba(77, 77, 77, 0.8); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-left-color: rgba(255, 255, 255, 0.5); border-right-color: rgba(255, 255, 255, 0.5); border-top-color: rgba(255, 255, 255, 0.5); border-bottom-color: rgba(255, 255, 255, 0.5); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; -unity-background-image-tint-color: rgb(255, 255, 255); transition-duration: 0.3s, 0.3s;">
                <ui:VisualElement class="key-holder">
                    <ui:Label text="E" name="InteractionKey" class="interaction-key" style="-unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                </ui:VisualElement>
                <ui:Label text="Interact" name="Label" style="font-size: 30px; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 15px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;); -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0);"/>
            </ui:VisualElement>
            <ui:VisualElement name="GrabPanel" style="flex-grow: 0; flex-direction: row; background-color: rgba(76, 76, 76, 0.8); padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-left-color: rgba(255, 255, 255, 0.5); border-right-color: rgba(255, 255, 255, 0.5); border-top-color: rgba(255, 255, 255, 0.5); border-bottom-color: rgba(255, 255, 255, 0.5); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-wrap: nowrap; transition-duration: 0.3s, 0.3s;">
                <ui:VisualElement class="key-holder" style="flex-shrink: 1;">
                    <ui:Label text="F" name="InteractionKey" class="interaction-key" style="-unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                </ui:VisualElement>
                <ui:Label text="Grab" name="Label" style="font-size: 30px; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 15px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-shrink: 1; -unity-font-definition: resource(&quot;Fonts/TIMES&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; background-size: 1% 1%; background-color: rgb(255, 255, 255); width: 10px; height: 10px; align-items: auto; justify-content: center; align-self: auto; align-content: auto; flex-basis: auto; flex-direction: column; -unity-background-scale-mode: stretch-to-fill; background-position-y: center; aspect-ratio: auto; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-wrap: nowrap; flex-shrink: 0; position: absolute; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
    </ui:VisualElement>
    <ui:VisualElement name="LevelEnd" style="flex-grow: 1; align-items: center; justify-content: center; display: none;">
        <ui:VisualElement style="flex-grow: 1; background-color: rgba(0, 0, 57, 0.7); width: 1000px; height: 70px; justify-content: flex-start; background-image: url(&quot;project://database/Assets/Textures/Tile_3_diffuse.png?fileID=2800000&amp;guid=b393ec4afd9a0cd4a8870db08c197abb&amp;type=3#Tile_3_diffuse&quot;); -unity-background-image-tint-color: rgba(116, 116, 116, 0.2); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; align-items: stretch; max-height: 900px;">
            <ui:VisualElement name="VisualElement" style="flex-direction: row; justify-content: center; margin-top: 30px; border-bottom-color: rgb(255, 255, 255); border-bottom-width: 2px; margin-bottom: 15px;">
                <ui:Label text="Level 1" name="LevelName" style="font-size: 80px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:Label text="Completed" style="font-size: 80px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; align-items: auto; justify-content: center; flex-direction: row; height: 70px; max-height: 70px; width: 268px; align-content: center; align-self: center;">
                <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; width: 70px; height: 70px;">
                    <ui:Image source="project://database/Assets/Textures/UI/StarIncomplete_silver.png?fileID=2800000&amp;guid=a56b0e4a64f5d2f4b91259fa79446d99&amp;type=3#StarIncomplete_silver" style="width: 70px; height: 70px; position: absolute; opacity: 1;"/>
                    <ui:Image source="project://database/Assets/Textures/UI/StarComplete_blue.png?fileID=2800000&amp;guid=ecb6e8cfc938bc84ba6ddccb61edb3d3&amp;type=3#StarComplete_blue" name="Star_1" class="star_hidden"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; width: 70px; height: 70px;">
                    <ui:Image source="project://database/Assets/Textures/UI/StarIncomplete_silver.png?fileID=2800000&amp;guid=a56b0e4a64f5d2f4b91259fa79446d99&amp;type=3#StarIncomplete_silver" style="width: 70px; height: 70px; position: absolute; opacity: 1;"/>
                    <ui:Image source="project://database/Assets/Textures/UI/StarComplete_blue.png?fileID=2800000&amp;guid=ecb6e8cfc938bc84ba6ddccb61edb3d3&amp;type=3#StarComplete_blue" name="Star_2" class="star_hidden"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; width: 70px; height: 70px;">
                    <ui:Image source="project://database/Assets/Textures/UI/StarIncomplete_silver.png?fileID=2800000&amp;guid=a56b0e4a64f5d2f4b91259fa79446d99&amp;type=3#StarIncomplete_silver" style="width: 70px; height: 70px; position: absolute; opacity: 1;"/>
                    <ui:Image source="project://database/Assets/Textures/UI/StarComplete_blue.png?fileID=2800000&amp;guid=ecb6e8cfc938bc84ba6ddccb61edb3d3&amp;type=3#StarComplete_blue" name="Star_3" class="star_hidden"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="" style="flex-grow: 1; flex-direction: row; align-items: flex-end; max-height: 70px; margin-right: 50px; margin-left: 50px;">
                <ui:Label text="Time:" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:Label text="55 min 55 s" name="TimeValue" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:VisualElement style="flex-grow: 1; border-top-width: 4px; border-top-color: rgb(255, 255, 255);"/>
                <ui:Label text="S" name="TimeGrade" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:Label text="New best!" name="TimeGradeImprove" class="update_tag update_tag_hidden"/>
            </ui:VisualElement>
            <ui:VisualElement name="" style="flex-grow: 1; border-top-width: 4px; border-top-color: rgb(255, 255, 255); max-height: 5px; margin-top: 25px; margin-bottom: 25px; margin-right: 20px; margin-left: 20px;"/>
            <ui:VisualElement name="" style="flex-grow: 1; flex-direction: row; align-items: flex-end; max-height: 70px; margin-right: 50px; margin-left: 50px;">
                <ui:Label text="Rooms:" name="" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:Label text="A, B, D, F, C, E, F, D, C" name="RoomsGrades" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="" style="flex-grow: 1; flex-direction: row; align-items: flex-end; max-height: 70px; margin-right: 50px; margin-left: 50px;">
                <ui:Label text="Final room grade" name="" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:VisualElement style="flex-grow: 1; border-top-width: 4px; border-top-color: rgb(255, 255, 255);"/>
                <ui:Label text="S" name="RoomFinalGrade" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:Label text="New best!" name="RoomGradeImprove" class="update_tag update_tag_hidden"/>
            </ui:VisualElement>
            <ui:VisualElement name="" style="flex-grow: 1; border-top-width: 4px; border-top-color: rgb(255, 255, 255); max-height: 5px; margin-top: 25px; margin-bottom: 25px; margin-right: 20px; margin-left: 20px;"/>
            <ui:VisualElement name="" style="flex-grow: 1; flex-direction: row; align-items: flex-end; max-height: 70px; margin-right: 50px; margin-left: 50px;">
                <ui:Label text="Level grade:" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:Label text="S" name="LevelGrade" style="font-size: 50px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-definition: resource(&quot;Fonts/TIMES&quot;);"/>
                <ui:Label text="New best!" name="LevelGradeImprove" class="update_tag update_tag_hidden"/>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="flex-direction: row; justify-content: space-around; align-items: center; flex-grow: 1;">
                <ui:Button text="Menu" name="Menu" class="menu-button"/>
                <ui:Button text="Continue" name="NextLevel" class="menu-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="Fade" picking-mode="Ignore" class="fade-out fade-in" style="position: absolute; width: 100%; height: 100%;"/>
</ui:UXML>
