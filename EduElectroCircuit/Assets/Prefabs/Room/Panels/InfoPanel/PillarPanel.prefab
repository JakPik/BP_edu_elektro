  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InfoWallPanel
  _uiDocument: {fileID: 2161305131146131701}
  _textTop: "Jak si m\u016F\u017Eete v\u0161imnout, v paraleln\xEDm zapojen\xED se
    proud rozd\u011Bluje do jednotliv\xFDch v\u011Btv\xED. V\u011Bt\u0161\xED proud
    p\u0159itom prot\xE9k\xE1 v\u011Btv\xED s men\u0161\xEDm odporem.\nPo op\u011Btovn\xE9m
    spojen\xED v\u011Btv\xED se proudy se\u010Dtou a v\xFDsledn\xFD proud m\xE1 stejnou
    hodnotu jako proud p\u0159ed rozv\u011Btven\xEDm."
  _topLabelStyle: 3
  _textBottom: 
  _bottomLabelStyle: 0
  _panelImage: {fileID: 0}
